{
  "name": "praxis",
  "private": true,
  "version": "0.1.0",
  "description": "Praxis \u2014 volunteer coverage and delegate-movement planner for IC26 San Diego hotels",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "lint": "oxlint src",
    "screens": "node scripts/screens.mjs",
    "data:build": "python3 scripts/build-data.py"
  },
  "dependencies": {
    "immer": "^10.1.1",
    "leaflet": "^1.9.4",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.184.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^6.1.0",
    "exceljs": "^4.4.0",
    "jsdom": "^26.1.0",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^3.2.4"
  }
}